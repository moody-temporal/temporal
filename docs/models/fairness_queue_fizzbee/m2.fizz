---
# Milestone 2: M1 + concurrent writer (reliable DB).
# Adds: fairTaskWriter.writeBatch (pin ack levels -> pick levels -> write ->
# merge -> unpin), mergeWrite mode with the bypass/eviction logic,
# newlyWrittenTasks buffering when a write races a pending read, and the
# ack-level pinning rules in ackLevelPinnedLocked/advanceAckLevelLocked.
#
# The DB starts empty; every task is created by the writer, at any unused
# level above the current (pinned) ack level — levels are NOT monotonic
# across writes, that's the point of the fair queue.
options:
  max_actions: 100
  max_concurrent_actions: 2
  crash_on_yield: false
deadlock_detection: false   # "all written tasks acked" is a valid final state
liveness: strict
---

MAX_LEVEL = 4    # universe of task levels: 1..MAX_LEVEL, each used at most once
BATCH_SIZE = 2   # config.GetTasksBatchSize()
RELOAD_AT = 1    # config.GetTasksReloadAt(): read more iff loaded <= RELOAD_AT

# outstandingTasks values (code: *internalTask vs nil)
LOADED = "LOADED"
ACKED = "ACKED"

# reader read-machinery state (code: readPending + position in readTasksImpl)
RS = enum('IDLE', 'LOOP', 'REQ', 'RESP')

# writer state (code: position in fairTaskWriter.writeBatch)
#   IDLE:  no write in progress
#   REQ:   ack level pinned, CreateFairTasks sent to DB
#   RESP:  DB applied the write and responded; wroteNewTasks not yet run
#   UNPIN: merge done, unpinAckLevel not yet run
WS = enum('IDLE', 'REQ', 'RESP', 'UNPIN')

# merge modes (code: mergeReadMiddle / mergeReadToEnd / mergeWrite)
MODE_MIDDLE = "READ_MIDDLE"
MODE_TO_END = "READ_TO_END"
MODE_WRITE = "WRITE"

action Init:
    # --- database state ---
    db_tasks = set()

    # --- reader state (fairTaskReader fields) ---
    outstanding = {}       # outstandingTasks: level -> LOADED | ACKED
    read_level = 0         # readLevel
    ack_level = 0          # ackLevel
    at_end = False         # atEnd
    newly_written = []     # newlyWrittenTasks
    pinned_by_writer = False   # ackLevelPinnedByWriter

    # --- writer state ---
    writer_state = WS.IDLE
    write_req = None       # levels of the in-flight write batch, or None

    # --- "network" between reader/writer/GC and DB ---
    read_req = None        # (readFrom-exclusive, batchSize) or None
    read_resp = None       # (levels list, hitEnd bool) or None

    # --- ghost variables (assertions only) ---
    confirmed = set()      # tasks whose write was confirmed to the writer
    ever_acked = set()     # tasks that were acked at least once
    stuck_detected = False # the "fair reader stuck" softassert fired
    ever_evicted = False   # a loaded task was evicted (sanity/exists)

    # Start(): initial maybeReadTasksLocked. Empty queue, nothing loaded:
    read_state = RS.LOOP

###############################################################################
# helpers: fairTaskReader methods, called under tr.lock
###############################################################################

atomic func loaded_count():
    # tr.loadedTasks (derived instead of tracked; the code asserts they match)
    return len([l for l in outstanding if outstanding[l] == LOADED])

atomic func should_read_more():
    # shouldReadMoreLocked
    if at_end:
        return False
    lc = loaded_count()
    if lc > RELOAD_AT:
        return False
    return True

atomic func maybe_read():
    # maybeReadTasksLocked (no backoff timer until M4)
    if read_state != RS.IDLE:
        return
    srm = should_read_more()
    if srm:
        read_state = RS.LOOP

atomic func ack_pinned():
    # ackLevelPinnedLocked
    return pinned_by_writer or len(newly_written) > 0

atomic func advance_ack():
    # advanceAckLevelLocked
    pinned = ack_pinned()
    if pinned:
        return
    for _ in range(MAX_LEVEL + 1):
        if len(outstanding) == 0:
            break
        m = min(outstanding.keys())
        if outstanding[m] != ACKED:
            break
        ack_level = m
        outstanding.pop(m)

atomic func merge_tasks(tasks, mode):
    # mergeTasksLocked. tasks: list of levels just read or written.

    # (1) currently loaded tasks + (2) incoming tasks, filtered:
    incoming = []
    for t in tasks:
        if t <= ack_level:
            # reads race acks: ignore tasks already at-or-below ack level
            continue
        elif mode == MODE_WRITE and not at_end and t > read_level:
            # not at end: can't accept writes above read level (unknown gap)
            continue
        elif t in outstanding:
            # already have it (loaded or acked)
            continue
        incoming.append(t)
    loaded_levels = [l for l in outstanding if outstanding[l] == LOADED]
    merged = sorted(loaded_levels + incoming)

    # keep the first BATCH_SIZE in memory
    keep = merged[:BATCH_SIZE]
    dropped = merged[BATCH_SIZE:]

    if len(keep) > 0:
        # readLevel = max level of what we keep in memory
        read_level = keep[-1]
    # else: merged is empty, leave read_level unchanged (fix f534e74e)

    evicted_any = False
    # evict loaded tasks that no longer fit (dropped incoming are just ignored)
    for t in dropped:
        evicted_any = True
        if outstanding.get(t, None) == LOADED:
            outstanding.pop(t)
            ever_evicted = True
            # the task is still in the DB; it will be re-read later

    # evict acks above the new read level (fix 8ca7b640 #4); they are
    # forgotten (re-read tasks get re-dispatched) until the M5 cache
    for t in [l for l in outstanding if outstanding[l] == ACKED and l > read_level]:
        outstanding.pop(t)
        evicted_any = True

    # add the kept incoming tasks to memory
    for t in keep:
        if t not in outstanding:
            outstanding[t] = LOADED

    # advance ack level (matters for expired/pre-acked entries, M3+)
    advance_ack()

    # update atEnd
    if mode == MODE_MIDDLE or evicted_any:
        at_end = False
    elif mode == MODE_TO_END:
        at_end = True

###############################################################################
# reader process
###############################################################################

atomic fair action ReaderReadLoop:
    # one iteration of the readTasksImpl for-loop (top of loop, under lock)
    require read_state == RS.LOOP
    srm = should_read_more()
    if srm:
        # readTaskBatch: send GetFairTasks(readLevel+1, batch) to the DB
        lc = loaded_count()
        read_req = (read_level, BATCH_SIZE - lc)
        read_state = RS.REQ
    else:
        # exit loop: readPending = false, process newlyWrittenTasks, then
        # re-check maybeReadTasksLocked (fix 26d9a561)
        read_state = RS.IDLE
        if len(newly_written) > 0:
            merge_tasks(newly_written, MODE_WRITE)
            newly_written = []
            # ack level was pinned by newlyWrittenTasks during the merge;
            # it may be able to advance now
            advance_ack()
        maybe_read()

atomic fair action ReaderMergeRead:
    # response arrived: retrier.Reset(); mergeTasks(res, mode); loop again
    require read_state == RS.RESP
    tasks = read_resp[0]
    hit_end = read_resp[1]
    read_resp = None
    read_state = RS.LOOP
    if hit_end:
        merge_tasks(tasks, MODE_TO_END)
    else:
        merge_tasks(tasks, MODE_MIDDLE)

###############################################################################
# writer process (fairTaskWriter.writeBatch)
###############################################################################

atomic action WriterWrite:
    # taskWriterLoop got an AddTask request: getAndPinAckLevels, pickPasses
    # (level above the pinned ack level, any unused level), CreateFairTasks.
    require writer_state == WS.IDLE
    # A level is available iff not already in the DB (db_tasks is monotone
    # with GC unmodeled, so this equals "never successfully written"). Real
    # ids are never reused, but a timed-out-unapplied write leaves no trace,
    # so reusing its level explores an isomorphic behavior while keeping the
    # level universe small (and dedups the retry states).
    avail = [l + 1 for l in range(MAX_LEVEL) if l + 1 not in db_tasks and l + 1 > ack_level]
    require len(avail) > 0
    t = oneof avail
    pinned_by_writer = True   # getAndPinAckLevel (softassert: wasn't pinned)
    write_req = [t]
    writer_state = WS.REQ

atomic fair action DbWrite:
    # DB applies CreateFairTasks atomically (reliable in M2)
    require writer_state == WS.REQ
    for t in write_req:
        db_tasks.add(t)
    writer_state = WS.RESP

atomic fair action WriterMergeWrite:
    # write returned success: backlogMgr.wroteNewTasks -> tr.mergeTasks(WRITE)
    require writer_state == WS.RESP
    for t in write_req:
        confirmed.add(t)
    if read_state != RS.IDLE:
        # concurrent read: hold the just-written tasks, merge after the read
        # (fix 12e7c43a)
        newly_written = newly_written + write_req
    else:
        merge_tasks(write_req, MODE_WRITE)
        # "fair reader stuck" softassert (fair_task_reader.go mergeTasks),
        # plus the defensive backstop read the real code performs. In M2
        # (no failures, no expired tasks) this state is unreachable — see
        # the NeverDetectsStuck assertion. In M3+ it IS reachable (via
        # expired tasks merged from a write while the ack level is pinned)
        # and the backstop read is what rescues liveness.
        lc = loaded_count()
        if not at_end and lc == 0:
            stuck_detected = True
            maybe_read()
    write_req = None
    writer_state = WS.UNPIN

atomic fair action WriterUnpin:
    # unpinAckLevel(nil)
    require writer_state == WS.UNPIN
    pinned_by_writer = False   # softassert: was pinned
    advance_ack()
    writer_state = WS.IDLE

###############################################################################
# acker process: eventually acks every loaded task
###############################################################################

atomic fair action AckTask:
    # completeTask happy path -> completeTaskLocked
    loaded = [l for l in outstanding if outstanding[l] == LOADED]
    require len(loaded) > 0
    # fair choice: every loaded task is eventually acked (every dispatched
    # task eventually completes); plain oneof would allow starvation cycles
    t = fair any loaded
    outstanding[t] = ACKED
    ever_acked.add(t)
    advance_ack()
    maybe_read()

# NOTE: the GC process is deliberately NOT modeled (review decision): GC only
# issues "delete where level <= ackLevel", which is safe by construction as
# long as AckLevelOnlyPassesAcked holds — that property IS the "never GC an
# unacked task" property. Failure/retry of the delete is idempotent and
# carries no obligations, so modeling it only multiplied the state space.

###############################################################################
# database process: executes reads
###############################################################################

atomic fair action DbRead:
    # DB executes GetFairTasks atomically
    require read_state == RS.REQ
    from_level = read_req[0]
    batch = read_req[1]
    res = sorted([t for t in db_tasks if t > from_level])[:batch]
    read_req = None
    read_resp = (res, len(res) < batch)
    read_state = RS.RESP

###############################################################################
# properties
###############################################################################

always assertion MemoryInWindow:
    # in-memory tasks (and pending acks) are exactly within (ackLevel, readLevel]
    if ack_level > read_level:
        return False
    for l in outstanding:
        if l <= ack_level or l > read_level:
            return False
    return True

always assertion WindowComplete:
    # everything at-or-below readLevel is accounted for: a confirmed task
    # still in the DB and inside (ackLevel, readLevel] must be tracked in
    # outstandingTasks or held in newlyWrittenTasks — otherwise the reader
    # would never re-read it and it would never be dispatched.
    for t in confirmed:
        if t in db_tasks and t > ack_level and t <= read_level:
            if t not in outstanding and t not in newly_written:
                return False
    return True

always assertion AckLevelOnlyPassesAcked:
    # (This also covers "never GC an unacked task": GC only deletes rows at
    # or below a previously observed ackLevel, and ackLevel is monotonic.)
    # if the ack level moved past a confirmed task, it must have been acked
    for t in confirmed:
        if t <= ack_level and t not in ever_acked:
            return False
    return True

always assertion NeverDetectsStuck:
    # the "fair reader stuck" defensive softassert never fires
    return not stuck_detected

transition assertion AckLevelMonotonic(before, after):
    return after.ack_level >= before.ack_level

# main liveness property: every confirmed task is eventually acked and the
# ack level eventually passes every confirmed task (reader never gets stuck)
eventually always assertion AllConfirmedTasksAcked:
    remaining = len([t for t in confirmed if t not in ever_acked])
    behind = len([t for t in confirmed if t > ack_level])
    return remaining == 0 and behind == 0

# sanity: interesting states are actually reachable
exists assertion BufferFills:
    return len([l for l in outstanding if outstanding[l] == LOADED]) == BATCH_SIZE

exists assertion EvictionHappens:
    return ever_evicted

exists assertion WriteBufferedDuringRead:
    return len(newly_written) > 0

exists assertion ReachesEnd:
    return at_end
